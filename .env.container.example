# Container environment variables for dev testing
# Copy this file to .env.container and update with your actual values

# HOST path for volume mounting (Docker-in-Docker compatibility)
# IMPORTANT: This must be the actual host filesystem path where your project is located
# NOT the path inside your DevContainer!
#
# To find your host path:
# 1. Check your DevContainer configuration
# 2. Run: docker inspect <your-devcontainer-name> | grep Source
# 3. Look for the volume mount that corresponds to your workspace
#
# Example:
# - DevContainer path: /home/code/workspaces/Zero
# - Host path: /home/fefe/code-server/workspaces/Zero (use this!)
HOST_PROJECT_PATH=/path/to/your/project/on/host

# Database connection (using container name from docker-compose.container.yaml)
# The hostname must match the service name in docker-compose.container.yaml
DATABASE_URL=postgresql://postgres:postgres@zerodotemail-db:5432/zerodotemail

# Redis/Upstash connection (using container names from docker-compose.container.yaml)
# The hostname must match the service name in docker-compose.container.yaml
REDIS_URL=http://zerodotemail-upstash-proxy:80
REDIS_TOKEN=upstash-local-token

# Basic app configuration (minimal for testing)
NODE_ENV=development
